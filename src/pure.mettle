// pure functions for the (pure ...) sink, with MORK's meanings. numbers are
// big endian symbols of their own size, i8 is one byte and f64 is eight

import "std/mem";
import "expr";

extern fn strtod(s: cstring, end: rawptr) -> float64;
extern fn strtof(s: cstring, end: rawptr) -> float32;
extern fn pure_dlopen(path: cstring, flags: int32) -> rawptr = "dlopen";
extern fn pure_dlsym(h: rawptr, name: cstring) -> rawptr = "dlsym";

// ln, sin and the rest come from the C maths library, as in MORK
var g_libm: rawptr = 0;

fn libm(name: cstring) -> rawptr {
  if (g_libm == 0) { g_libm = pure_dlopen("libm.so.6", 2); }
  if (g_libm == 0) { return (rawptr)0; }
  return pure_dlsym(g_libm, name);
}

fn libm_name(op: string, single: bool) -> cstring {
  if (single) {
    if (op == "sin") { return "sinf"; }
    if (op == "cos") { return "cosf"; }
    if (op == "tan") { return "tanf"; }
    if (op == "asin") { return "asinf"; }
    if (op == "acos") { return "acosf"; }
    if (op == "atan") { return "atanf"; }
    if (op == "sinh") { return "sinhf"; }
    if (op == "cosh") { return "coshf"; }
    if (op == "tanh") { return "tanhf"; }
    if (op == "cbrt") { return "cbrtf"; }
    if (op == "exp") { return "expf"; }
    if (op == "exp2") { return "exp2f"; }
    if (op == "ln") { return "logf"; }
    if (op == "log2") { return "log2f"; }
    if (op == "log10") { return "log10f"; }
    if (op == "powf") { return "powf"; }
    if (op == "atan2") { return "atan2f"; }
    if (op == "hypot") { return "hypotf"; }
    return (cstring)0;
  }
  if (op == "sin") { return "sin"; }
  if (op == "cos") { return "cos"; }
  if (op == "tan") { return "tan"; }
  if (op == "asin") { return "asin"; }
  if (op == "acos") { return "acos"; }
  if (op == "atan") { return "atan"; }
  if (op == "sinh") { return "sinh"; }
  if (op == "cosh") { return "cosh"; }
  if (op == "tanh") { return "tanh"; }
  if (op == "cbrt") { return "cbrt"; }
  if (op == "exp") { return "exp"; }
  if (op == "exp2") { return "exp2"; }
  if (op == "ln") { return "log"; }
  if (op == "log2") { return "log2"; }
  if (op == "log10") { return "log10"; }
  if (op == "powf") { return "pow"; }
  if (op == "atan2") { return "atan2"; }
  if (op == "hypot") { return "hypot"; }
  return (cstring)0;
}

fn libm_call(op: string, t: int32, x: float64, y: float64, two: bool, r: float64*) -> bool {
  var name: cstring = libm_name(op, t == T_F32);
  if (name == 0) { return false; }
  var binary: bool = op == "powf" || op == "atan2" || op == "hypot";
  if (binary != two) { return false; }
  var f: rawptr = libm(name);
  if (f == 0) { return false; }
  if (t == T_F32) {
    if (two) {
      var g2: fn(float32, float32) -> float32 = (fn(float32, float32) -> float32)f;
      *r = (float64)g2((float32)x, (float32)y);
    } else {
      var g1: fn(float32) -> float32 = (fn(float32) -> float32)f;
      *r = (float64)g1((float32)x);
    }
    return true;
  }
  if (two) {
    var h2: fn(float64, float64) -> float64 = (fn(float64, float64) -> float64)f;
    *r = h2(x, y);
  } else {
    var h1: fn(float64) -> float64 = (fn(float64) -> float64)f;
    *r = h1(x);
  }
  return true;
}

const T_I8: int32 = 1;
const T_I16: int32 = 2;
const T_I32: int32 = 3;
const T_I64: int32 = 4;
const T_U8: int32 = 5;
const T_U16: int32 = 6;
const T_U32: int32 = 7;
const T_U64: int32 = 8;
const T_F32: int32 = 9;
const T_F64: int32 = 10;

fn pv(p: uint8*, n: int64) -> string {
  var s: string;
  s.chars = p;
  s.length = (uint64)n;
  return s;
}

fn ty_size(t: int32) -> int64 {
  if (t == T_I8 || t == T_U8) { return 1; }
  if (t == T_I16 || t == T_U16) { return 2; }
  if (t == T_I32 || t == T_U32 || t == T_F32) { return 4; }
  return 8;
}

fn ty_signed(t: int32) -> bool { return t >= T_I8 && t <= T_I64; }
fn ty_float(t: int32) -> bool { return t == T_F32 || t == T_F64; }

fn ty_of(s: string) -> int32 {
  if (s == "i8") { return T_I8; }
  if (s == "i16") { return T_I16; }
  if (s == "i32") { return T_I32; }
  if (s == "i64") { return T_I64; }
  if (s == "u8") { return T_U8; }
  if (s == "u16") { return T_U16; }
  if (s == "u32") { return T_U32; }
  if (s == "u64") { return T_U64; }
  if (s == "f32") { return T_F32; }
  if (s == "f64") { return T_F64; }
  return 0;
}

fn wrap(t: int32, v: int64) -> int64 {
  var bits: int64 = ty_size(t) * 8;
  if (bits == 64) { return v; }
  var u: uint64 = (uint64)v & (((uint64)1 << (uint64)bits) - (uint64)1);
  if (ty_signed(t) && (u >> (uint64)(bits - 1)) != (uint64)0) {
    u = u | ~(((uint64)1 << (uint64)bits) - (uint64)1);
  }
  return (int64)u;
}

fn put_int(out: MercBuf*, t: int32, v: int64) -> bool {
  var n: int64 = ty_size(t);
  merc_buf_push(out, (uint8)(0xC0 + n));
  var k: int64 = n - 1;
  while (k >= 0) {
    merc_buf_push(out, (uint8)(((uint64)v >> (uint64)(k * 8)) & (uint64)255));
    k = k - 1;
  }
  return true;
}

fn put_f(out: MercBuf*, t: int32, x: float64) -> bool {
  if (t == T_F32) {
    var f: float32 = (float32)x;
    return put_int(out, T_U32, (int64)bits_from_f32(f));
  }
  return put_int(out, T_I64, f64_bits(x));
}

fn put_i8(out: MercBuf*, b: bool) -> bool {
  if (b) { return put_int(out, T_I8, 1); }
  return put_int(out, T_I8, 0);
}

struct Args {
  p: uint8*;
  n: int64;
  count: int32;
  at: int64;
  bad: bool;
}

fn arg_next(a: Args*) -> int64 {
  var start: int64 = a->at;
  var k: int64 = merc_span(a->p + start, a->n - start);
  if (k < 0) {
    a->bad = true;
    return start;
  }
  a->at = start + k;
  return start;
}

fn arg_int(a: Args*, t: int32) -> int64 {
  var at: int64 = arg_next(a);
  var n: int64 = ty_size(t);
  if (a->bad || a->p[at] != (uint8)(0xC0 + n)) {
    a->bad = true;
    return 0;
  }
  var v: uint64 = 0;
  for k: int64 in 0..n { v = (v << (uint64)8) | (uint64)a->p[at + 1 + k]; }
  return wrap(t, (int64)v);
}

fn arg_f(a: Args*, t: int32) -> float64 {
  if (t == T_F32) {
    var b: int64 = arg_int(a, T_U32);
    return (float64)f32_from_bits((uint32)b);
  }
  return f64_from_bits(arg_int(a, T_I64));
}

fn arg_sym(a: Args*, len: int64*) -> uint8* {
  var at: int64 = arg_next(a);
  if (a->bad || a->p[at] <= 0xC0) {
    a->bad = true;
    *len = 0;
    return a->p;
  }
  *len = (int64)(a->p[at] & 63);
  return a->p + at + 1;
}

// whole numbers as Rust parses them
fn parse_int(t: int32, p: uint8*, n: int64, out: int64*) -> bool {
  var i: int64 = 0;
  var neg: bool = false;
  if (n > 0 && (p[0] == 43 || p[0] == 45)) {
    neg = p[0] == 45;
    i = 1;
  }
  if (i >= n) { return false; }
  var bits: int64 = ty_size(t) * 8;
  var lim: uint64 = (uint64)1 << (uint64)(bits - 1);
  if (bits == 64) { lim = (uint64)0x8000000000000000; }
  var v: uint64 = 0;

  while (i < n) {
    var c: uint8 = p[i];
    if (c < 48 || c > 57) { return false; }
    var d: uint64 = (uint64)(c - 48);
    if (v > (lim - d) / (uint64)10 + (uint64)1) { return false; }
    v = v * (uint64)10 + d;
    if (v > lim) { return false; }
    i = i + 1;
  }

  if (!neg && v == lim) { return false; }
  if (neg) {
    *out = (int64)((uint64)0 - v);
  } else {
    *out = (int64)v;
  }
  return true;
}

fn lower(c: uint8) -> uint8 {
  if (c >= 65 && c <= 90) { return c + 32; }
  return c;
}

fn word_is(p: uint8*, n: int64, w: string) -> bool {
  if (n != (int64)w.length) { return false; }
  for k: int64 in 0..n {
    if (lower(p[k]) != w.chars[k]) { return false; }
  }
  return true;
}

// what Rust accepts as a float
fn float_text_ok(p: uint8*, n: int64) -> bool {
  var i: int64 = 0;
  if (n > 0 && (p[0] == 43 || p[0] == 45)) { i = 1; }
  var rest: int64 = n - i;
  if (word_is(p + i, rest, "inf") || word_is(p + i, rest, "infinity") ||
    word_is(p + i, rest, "nan")) {
    return true;
  }
  var digits: int64 = 0;

  while (i < n && p[i] >= 48 && p[i] <= 57) {
    i = i + 1;
    digits = digits + 1;
  }

  if (i < n && p[i] == 46) {
    i = i + 1;
    while (i < n && p[i] >= 48 && p[i] <= 57) {
      i = i + 1;
      digits = digits + 1;
    }
  }
  if (digits == 0) { return false; }
  if (i < n && (p[i] == 101 || p[i] == 69)) {
    i = i + 1;
    if (i < n && (p[i] == 43 || p[i] == 45)) { i = i + 1; }
    var ed: int64 = 0;
    while (i < n && p[i] >= 48 && p[i] <= 57) {
      i = i + 1;
      ed = ed + 1;
    }
    if (ed == 0) { return false; }
  }
  return i == n;
}

fn parse_float(t: int32, p: uint8*, n: int64, out: float64*) -> bool {
  if (!float_text_ok(p, n)) { return false; }
  var i: int64 = 0;
  var sign: int64 = 0;
  if (p[0] == 43 || p[0] == 45) {
    i = 1;
    if (p[0] == 45) { sign = (int64)0x8000000000000000; }
  }
  if (word_is(p + i, n - i, "nan")) {
    *out = f64_from_bits(0x7FF8000000000000 | sign);
    return true;
  }
  if (p[i] == 105 || p[i] == 73) {
    *out = f64_from_bits(0x7FF0000000000000 | sign);
    return true;
  }
  var z: uint8[80];
  for k: int64 in 0..n { z[k] = p[k]; }
  z[n] = 0;
  if (t == T_F32) {
    *out = (float64)strtof((cstring)&z[0], (rawptr)0);
  } else {
    *out = strtod((cstring)&z[0], (rawptr)0);
  }
  return true;
}

fn put_dec(out: MercBuf*, v: int64) {
  var d: uint8[24];
  var k: int32 = 0;
  var u: uint64 = (uint64)v;
  if (v < 0) { u = (uint64)0 - (uint64)v; }
  if (u == (uint64)0) {
    d[0] = 48;
    k = 1;
  }
  while (u > (uint64)0) {
    d[k] = (uint8)(48 + (int32)(u % (uint64)10));
    u = u / (uint64)10;
    k = k + 1;
  }
  if (v < 0) { merc_buf_push(out, 45); }
  while (k > 0) {
    k = k - 1;
    merc_buf_push(out, d[k]);
  }
}

// base 1e9, lowest part first
struct Big {
  w: uint32[120];
  n: int32;
}

fn big_mul(b: Big*, m: uint64) {
  var carry: uint64 = 0;
  for i: int32 in 0..b->n {
    var x: uint64 = (uint64)b->w[i] * m + carry;
    b->w[i] = (uint32)(x % (uint64)1000000000);
    carry = x / (uint64)1000000000;
  }
  while (carry > (uint64)0) {
    b->w[b->n] = (uint32)(carry % (uint64)1000000000);
    carry = carry / (uint64)1000000000;
    b->n = b->n + 1;
  }
}

fn exact_digits(x: float64, d: uint8*, nd: int32*, e10: int32*) {
  var bits: uint64 = (uint64)f64_bits(x);
  var be: int32 = (int32)((bits >> (uint64)52) & (uint64)0x7FF);
  var m: uint64 = bits & (uint64)0x000FFFFFFFFFFFFF;
  if (be == 0) {
    be = 1;
  } else {
    m = m | ((uint64)1 << (uint64)52);
  }
  var e2: int32 = be - 1075;

  while (m != (uint64)0 && (m & (uint64)1) == (uint64)0) {
    m = m >> (uint64)1;
    e2 = e2 + 1;
  }

  var b: Big;
  b.n = 0;
  var mm: uint64 = m;

  while (mm > (uint64)0) {
    b.w[b.n] = (uint32)(mm % (uint64)1000000000);
    mm = mm / (uint64)1000000000;
    b.n = b.n + 1;
  }

  var shift: int32 = 0;
  if (e2 > 0) {
    var left: int32 = e2;
    while (left >= 30) {
      big_mul(&b, (uint64)1 << (uint64)30);
      left = left - 30;
    }
    if (left > 0) { big_mul(&b, (uint64)1 << (uint64)left); }
  } else if (e2 < 0) {
    var left2: int32 = -e2;
    while (left2 >= 13) {
      big_mul(&b, (uint64)1220703125);
      left2 = left2 - 13;
    }
    var f: uint64 = 1;
    for k in 0..left2 { f = f * (uint64)5; }
    if (left2 > 0) { big_mul(&b, f); }
    shift = e2;
  }
  var k2: int32 = 0;
  var top: uint32 = b.w[b.n - 1];
  var tmp: uint8[12];
  var tn: int32 = 0;

  while (top > (uint32)0) {
    tmp[tn] = (uint8)(48 + (int32)(top % (uint32)10));
    top = top / (uint32)10;
    tn = tn + 1;
  }

  while (tn > 0) {
    tn = tn - 1;
    d[k2] = tmp[tn];
    k2 = k2 + 1;
  }

  var i: int32 = b.n - 2;

  while (i >= 0) {
    var w: uint32 = b.w[i];
    var j: int32 = 8;
    while (j >= 0) {
      d[k2 + j] = (uint8)(48 + (int32)(w % (uint32)10));
      w = w / (uint32)10;
      j = j - 1;
    }
    k2 = k2 + 9;
    i = i - 1;
  }

  *nd = k2;
  *e10 = k2 - 1 + shift;
}

fn back_same(t: int32, x: float64, d: uint8*, n: int32, e10: int32) -> bool {
  var s: uint8[48];
  var k: int32 = 0;
  s[k] = d[0];
  k = k + 1;
  if (n > 1) {
    s[k] = 46;
    k = k + 1;
    for i in 1..n {
      s[k] = d[i];
      k = k + 1;
    }
  }
  s[k] = 101;
  k = k + 1;
  var e: int32 = e10;
  if (e < 0) {
    s[k] = 45;
    k = k + 1;
    e = -e;
  }
  var ed: uint8[8];
  var en: int32 = 0;
  if (e == 0) {
    ed[0] = 48;
    en = 1;
  }

  while (e > 0) {
    ed[en] = (uint8)(48 + e % 10);
    e = e / 10;
    en = en + 1;
  }

  while (en > 0) {
    en = en - 1;
    s[k] = ed[en];
    k = k + 1;
  }

  s[k] = 0;
  if (t == T_F32) {
    var f: float32 = strtof((cstring)&s[0], (rawptr)0);
    return bits_from_f32(f) == bits_from_f32((float32)x);
  }
  return f64_bits(strtod((cstring)&s[0], (rawptr)0)) == f64_bits(x);
}

// the shortest digits that read back as x, the closest when two fit
fn shortest(t: int32, x: float64, d: uint8*, nd: int32*, e10: int32*) {
  var all: uint8[800];
  var an: int32 = 0;
  var ae: int32 = 0;
  exact_digits(x, &all[0], &an, &ae);

  for p in 1..18 {
    if (p >= an) {
      for k in 0..an { d[k] = all[k]; }
      var n0: int32 = an;
      while (n0 > 1 && d[n0 - 1] == 48) { n0 = n0 - 1; }
      *nd = n0;
      *e10 = ae;
      return;
    }
    var down: uint8[20];
    var up: uint8[20];
    for k2 in 0..p {
      down[k2] = all[k2];
      up[k2] = all[k2];
    }
    var ue: int32 = ae;
    var i: int32 = p - 1;
    var carry: bool = true;
    while (carry && i >= 0) {
      if (up[i] == 57) {
        up[i] = 48;
        i = i - 1;
      } else {
        up[i] = up[i] + 1;
        carry = false;
      }
    }
    if (carry) {
      up[0] = 49;
      for k3 in 1..p { up[k3] = 48; }
      ue = ae + 1;
    }
    var cmp: int32 = 0;
    if (all[p] > 53) { cmp = 1; }
    else if (all[p] < 53) { cmp = -1; }
    else {
      for k4 in (p + 1)..an {
        if (all[k4] != 48) { cmp = 1; }
      }
      if (cmp == 0 && ((int32)(all[p - 1] - 48) % 2) == 0) { cmp = -1; }
      if (cmp == 0) { cmp = 1; }
    }
    var dn: bool = back_same(t, x, &down[0], p, ae);
    var un: bool = back_same(t, x, &up[0], p, ue);
    if (dn || un) {
      var use_up: bool = un && (!dn || cmp > 0);
      var n1: int32 = p;
      if (use_up) {
        for k5 in 0..p { d[k5] = up[k5]; }
        *e10 = ue;
      } else {
        for k6 in 0..p { d[k6] = down[k6]; }
        *e10 = ae;
      }
      while (n1 > 1 && d[n1 - 1] == 48) { n1 = n1 - 1; }
      *nd = n1;
      return;
    }
  }
}

// as Rust writes it. {:?} gives 1e16 or 1.5e-5, plain {} gives
// 10000000000000000 and 0.000015 with no .0 on whole numbers
fn float_text(x: float64, single: bool, plain: bool, out: MercBuf*) {

  var t: int32 = T_F64;
  if (single) { t = T_F32; }
  if (isnan(x)) {
    merc_buf_text(out, "NaN");
    return;
  }
  if (f64_bits(x) < 0) { merc_buf_push(out, 45); }
  var a: float64 = x;
  if (a < 0.0) { a = -a; }
  if (a == INF()) {
    merc_buf_text(out, "inf");
    return;
  }
  if (a == 0.0) {
    if (plain) {
      merc_buf_text(out, "0");
    } else {
      merc_buf_text(out, "0.0");
    }
    return;
  }
  var d: uint8[24];
  var nd: int32 = 0;
  var e10: int32 = 0;
  shortest(t, a, &d[0], &nd, &e10);
  if (!plain && (a < 0.0001 || a >= 10000000000000000.0)) {
    merc_buf_push(out, d[0]);
    if (nd > 1) {
      merc_buf_push(out, 46);
      merc_buf_add(out, &d[1], (int64)(nd - 1));
    }
    merc_buf_push(out, 101);
    put_dec(out, (int64)e10);
    return;
  }
  if (e10 < 0) {
    merc_buf_text(out, "0.");
    for k in 0..(-e10 - 1) { merc_buf_push(out, 48); }
    merc_buf_add(out, &d[0], (int64)nd);
    return;
  }

  for k2 in 0..(e10 + 1) {
    if (k2 < nd) {
      merc_buf_push(out, d[k2]);
    } else {
      merc_buf_push(out, 48);
    }
  }

  if (nd > e10 + 1) {
    merc_buf_push(out, 46);
    merc_buf_add(out, &d[e10 + 1], (int64)(nd - e10 - 1));
  } else if (!plain) {
    merc_buf_text(out, ".0");
  }
}

export fn merc_pure_float_text(x: float64, single: bool, out: MercBuf*) {
  float_text(x, single, false, out);
}

export fn merc_pure_float_plain(x: float64, out: MercBuf*) {
  float_text(x, false, true, out);
}

export fn merc_pure_parse_f64(p: uint8*, n: int64, out: float64*) -> bool {
  return parse_float(T_F64, p, n, out);
}

fn put_text(out: MercBuf*, tmp: MercBuf*) -> bool {
  if (tmp->len < 1 || tmp->len > 63) { return false; }
  merc_buf_push(out, (uint8)(0xC0 + tmp->len));
  merc_buf_add(out, tmp->data, tmp->len);
  return true;
}

fn f64_bits(x: float64) -> int64 { return __mtl_f64_bits(x); }
fn f64_from_bits(b: int64) -> float64 { return __mtl_f64_from_bits(b); }
fn bits_from_f32(x: float32) -> uint32 { return __mtl_f32_bits(x); }
fn f32_from_bits(b: uint32) -> float32 { return __mtl_f32_from_bits(b); }
fn INF() -> float64 { return __mtl_f64_from_bits(0x7FF0000000000000); }

fn isnan(x: float64) -> bool {
  return (f64_bits(x) & 0x7FFFFFFFFFFFFFFF) > 0x7FF0000000000000;
}

fn ftrunc(x: float64) -> float64 {
  if (isnan(x) || x >= 4503599627370496.0 || x <= -4503599627370496.0) { return x; }
  var t: float64 = (float64)(int64)x;
  if (t == 0.0 && f64_bits(x) < 0) { return -0.0; }
  return t;
}

fn ffloor(x: float64) -> float64 {
  var t: float64 = ftrunc(x);
  if (x < 0.0 && t != x) { return t - 1.0; }
  return t;
}

fn fceil(x: float64) -> float64 {
  var t: float64 = ftrunc(x);
  if (x > 0.0 && t != x) { return t + 1.0; }
  return t;
}

fn fround(x: float64) -> float64 {
  var t: float64 = ftrunc(x);
  var d: float64 = x - t;
  if (d >= 0.5) { return t + 1.0; }
  if (d <= -0.5) { return t - 1.0; }
  return t;
}

fn fsignum(x: float64) -> float64 {
  if (isnan(x)) { return x; }
  if (f64_bits(x) < 0) { return -1.0; }
  return 1.0;
}

fn fmaxr(a: float64, b: float64) -> float64 {
  if (isnan(b)) { return a; }
  if (isnan(a)) { return b; }
  if (b > a) { return b; }
  return a;
}

fn fminr(a: float64, b: float64) -> float64 {
  if (isnan(b)) { return a; }
  if (isnan(a)) { return b; }
  if (b < a) { return b; }
  return a;
}

// float results are worked in the type itself, so f32 rounds every step.
fn fr(t: int32, x: float64) -> float64 {
  if (t == T_F32) { return (float64)(float32)x; }
  return x;
}

fn powi(t: int32, a0: float64, b0: int32) -> float64 {
  var recip: bool = b0 < 0;
  var a: float64 = a0;
  var b: int32 = b0;
  var r: float64 = 1.0;
  while (true) {
    if ((b & 1) != 0) { r = fr(t, r * a); }
    b = b / 2;
    if (b == 0) { break; }
    a = fr(t, a * a);
  }
  if (recip) { return fr(t, 1.0 / r); }
  return r;
}

// like Rust's as: saturate, NaN is zero
fn f_to_int(t: int32, x: float64) -> int64 {
  if (isnan(x)) { return 0; }
  var bits: int64 = ty_size(t) * 8;
  if (ty_signed(t)) {
    var hi: float64 = 9223372036854775807.0;
    var lo: float64 = -9223372036854775808.0;
    if (bits < 64) {
      hi = (float64)(((int64)1 << (int64)(bits - 1)) - (int64)1);
      lo = -(float64)((int64)1 << (int64)(bits - 1));
    }
    if (x >= hi) {
      if (bits == 64) { return 9223372036854775807; }
      return ((int64)1 << (int64)(bits - 1)) - (int64)1;
    }
    if (x <= lo) {
      if (bits == 64) { return (int64)0x8000000000000000; }
      return -((int64)1 << (int64)(bits - 1));
    }
    return (int64)x;
  }
  if (x <= 0.0) { return 0; }
  if (bits == 64) {
    if (x >= 18446744073709551615.0) { return -1; }
    if (x >= 9223372036854775808.0) {
      return (int64)((uint64)(x - 9223372036854775808.0) + (uint64)0x8000000000000000);
    }
    return (int64)x;
  }
  var top: float64 = (float64)(((int64)1 << (int64)bits) - (int64)1);
  if (x >= top) { return ((int64)1 << (int64)bits) - (int64)1; }
  return (int64)x;
}

fn i_to_f(from: int32, v: int64) -> float64 {
  if (from == T_U64 && v < 0) {
    var half: uint64 = ((uint64)v >> (uint64)1) | ((uint64)v & (uint64)1);
    return (float64)(int64)half * 2.0;
  }
  return (float64)v;
}

fn i_to_f32(from: int32, v: int64) -> float64 {
  if (from == T_U64 && v < 0) {
    var half: uint64 = ((uint64)v >> (uint64)1) | ((uint64)v & (uint64)1);
    return (float64)((float32)(int64)half * (float32)2.0);
  }
  return (float64)(float32)v;
}

fn bit_count(t: int32, v: int64) -> int64 {
  var u: uint64 = (uint64)wrap(T_U64, v);
  var n: int64 = 0;
  var bits: int64 = ty_size(t) * 8;
  for k: int64 in 0..bits {
    if (((u >> (uint64)k) & (uint64)1) != (uint64)0) { n = n + 1; }
  }
  return n;
}

fn lead(t: int32, v: int64, one: bool) -> int64 {
  var bits: int64 = ty_size(t) * 8;
  var n: int64 = 0;
  var k: int64 = bits - 1;
  while (k >= 0) {
    var b: bool = (((uint64)v >> (uint64)k) & (uint64)1) != (uint64)0;
    if (b != one) { break; }
    n = n + 1;
    k = k - 1;
  }
  return n;
}

fn unsigned_op(t: int32, op: string, a: Args*, out: MercBuf*) -> bool {
  var bits: int64 = ty_size(t) * 8;
  var c: int32 = a->count;
  if (op == "zeros" && c == 0) { return put_int(out, t, 0); }
  if (op == "ones" && c == 0) { return put_int(out, t, -1); }
  if (op == "and" || op == "or" || op == "parity") {
    var acc: int64 = 0;
    if (op == "and") { acc = -1; }
    for i in 0..c {
      var x: int64 = arg_int(a, t);
      if (op == "and") {
        acc = acc & x;
      } else if (op == "or") {
        acc = acc | x;
      } else {
        acc = acc ^ x;
      }
    }
    if (a->bad) { return false; }
    return put_int(out, t, acc);
  }
  if (c == 1) {
    var x1: int64 = arg_int(a, t);
    if (a->bad) { return false; }
    if (op == "not") { return put_int(out, t, ~x1); }
    if (op == "count_ones") { return put_int(out, T_U32, bit_count(t, x1)); }
    if (op == "count_zeros") { return put_int(out, T_U32, bits - bit_count(t, x1)); }
    if (op == "leading_zeros") { return put_int(out, T_U32, lead(t, x1, false)); }
    if (op == "leading_ones") { return put_int(out, T_U32, lead(t, x1, true)); }
    if (op == "swap_bytes") {
      var r: int64 = 0;
      var nb: int64 = ty_size(t);
      for k: int64 in 0..nb {
        var byte: int64 = (int64)(((uint64)x1 >> (uint64)(k * 8)) & (uint64)255);
        r = r | (int64)((uint64)byte << (uint64)((nb - 1 - k) * 8));
      }
      return put_int(out, t, r);
    }
    if (op == "reverse_bits") {
      var r2: uint64 = 0;
      for k2: int64 in 0..bits {
        if ((((uint64)x1 >> (uint64)k2) & (uint64)1) != (uint64)0) {
          r2 = r2 | ((uint64)1 << (uint64)(bits - 1 - k2));
        }
      }
      return put_int(out, t, (int64)r2);
    }
    return false;
  }
  if (c == 2) {
    var x2: int64 = arg_int(a, t);
    if (op == "shl" || op == "shr") {
      var s: int64 = arg_int(a, T_U32);
      if (a->bad || s >= bits) { return false; }
      var u: uint64 = (uint64)x2;
      if (bits < 64) { u = u & (((uint64)1 << (uint64)bits) - (uint64)1); }
      if (op == "shl") { return put_int(out, t, (int64)(u << (uint64)s)); }
      return put_int(out, t, (int64)(u >> (uint64)s));
    }
    var y2: int64 = arg_int(a, t);
    if (a->bad) { return false; }
    if (op == "nand") { return put_int(out, t, ~(x2 & y2)); }
    if (op == "andn") { return put_int(out, t, x2 & ~y2); }
    if (op == "nor") { return put_int(out, t, ~(x2 | y2)); }
    if (op == "xor") { return put_int(out, t, x2 ^ y2); }
    if (op == "xnor") { return put_int(out, t, ~(x2 ^ y2)); }
    if (op == "eq" && t == T_U32) { return put_int(out, T_U8, (int64)(x2 == y2)); }
  }
  return false;
}

fn int_cmp(op: string, x: int64, y: int64, out: MercBuf*) -> int32 {
  if (op == "lt") {
    put_i8(out, x < y);
    return 1;
  }
  if (op == "gt") {
    put_i8(out, x > y);
    return 1;
  }
  if (op == "lte") {
    put_i8(out, x <= y);
    return 1;
  }
  if (op == "gte") {
    put_i8(out, x >= y);
    return 1;
  }
  if (op == "eq") {
    put_i8(out, x == y);
    return 1;
  }
  if (op == "ne") {
    put_i8(out, x != y);
    return 1;
  }
  return 0;
}

fn wpow(t: int32, x: int64, e: uint32) -> int64 {
  var r: uint64 = 1;
  var b: uint64 = (uint64)x;
  var k: uint32 = e;
  while (k > (uint32)0) {
    if ((k & (uint32)1) != (uint32)0) { r = r * b; }
    b = b * b;
    k = k >> (uint32)1;
  }
  return wrap(t, (int64)r);
}

fn signed_op(t: int32, op: string, a: Args*, out: MercBuf*) -> bool {
  var c: int32 = a->count;
  var bits: int64 = ty_size(t) * 8;
  var lo: int64 = (int64)0x8000000000000000;
  if (bits < 64) { lo = -((int64)1 << (int64)(bits - 1)); }
  var hi: int64 = -(lo + 1);
  if (op == "sum" || op == "product" || op == "max" || op == "min") {
    var acc: int64 = 0;
    if (op == "product") { acc = 1; }
    if (op == "max") { acc = lo; }
    if (op == "min") { acc = hi; }
    for i in 0..c {
      var x: int64 = arg_int(a, t);
      if (op == "sum") {
        acc = wrap(t, acc + x);
      } else if (op == "product") {
        acc = wrap(t, acc * x);
      } else if (op == "max") {
        if (x > acc) { acc = x; }
      } else {
        if (x < acc) { acc = x; }
      }
    }
    if (a->bad) { return false; }
    return put_int(out, t, acc);
  }
  if (c == 1) {
    var x1: int64 = arg_int(a, t);
    if (a->bad) { return false; }
    if (op == "neg") { return put_int(out, t, wrap(t, (int64)((uint64)0 - (uint64)x1))); }
    if (op == "abs") {
      if (x1 < 0) { return put_int(out, t, wrap(t, (int64)((uint64)0 - (uint64)x1))); }
      return put_int(out, t, x1);
    }
    if (op == "signum") {
      if (x1 > 0) { return put_int(out, t, 1); }
      if (x1 < 0) { return put_int(out, t, -1); }
      return put_int(out, t, 0);
    }
    return false;
  }
  if (c == 2) {
    var x2: int64 = arg_int(a, t);
    var y2: int64 = arg_int(a, t);
    if (a->bad) { return false; }
    if (op == "sub") { return put_int(out, t, wrap(t, (int64)((uint64)x2 - (uint64)y2))); }
    if (op == "div") {
      if (y2 == 0 || (x2 == lo && y2 == -1)) { return false; }
      return put_int(out, t, x2 / y2);
    }
    if (op == "mod") {
      if (y2 == 0 || (x2 == lo && y2 == -1)) { return false; }
      return put_int(out, t, x2 % y2);
    }
    if (op == "pow") { return put_int(out, t, wpow(t, x2, (uint32)y2)); }
    return int_cmp(op, x2, y2, out) == 1;
  }
  if (c == 3 && op == "clamp") {
    var x3: int64 = arg_int(a, t);
    var mn: int64 = arg_int(a, t);
    var mx: int64 = arg_int(a, t);
    if (a->bad || mn > mx) { return false; }
    if (x3 < mn) { x3 = mn; }
    if (x3 > mx) { x3 = mx; }
    return put_int(out, t, x3);
  }
  return false;
}

fn float_op(t: int32, op: string, a: Args*, out: MercBuf*) -> bool {
  var c: int32 = a->count;
  if (c == 0) {
    if (op == "inf") { return put_f(out, t, INF()); }
    if (op == "neginf") { return put_f(out, t, -INF()); }
    if (op == "e") { return put_f(out, t, 2.718281828459045); }
    if (op == "pi") { return put_f(out, t, 3.141592653589793); }
    if (op == "tau") { return put_f(out, t, 6.283185307179586); }
    if (op == "phi") { return put_f(out, t, 1.618033988749895); }
  }
  if (op == "sum" || op == "product" || op == "max" || op == "min") {
    var acc: float64 = 0.0;
    if (op == "product") { acc = 1.0; }
    if (op == "max") { acc = -INF(); }
    if (op == "min") { acc = INF(); }
    for i in 0..c {
      var x: float64 = arg_f(a, t);
      if (op == "sum") { acc = fr(t, acc + x); }
      else if (op == "product") { acc = fr(t, acc * x); }
      else if (op == "max") { acc = fmaxr(acc, x); }
      else { acc = fminr(acc, x); }
    }
    if (a->bad) { return false; }
    return put_f(out, t, acc);
  }
  if (c == 1) {
    var x1: float64 = arg_f(a, t);
    if (a->bad) { return false; }
    if (op == "neg") { return put_f(out, t, -x1); }
    if (op == "abs") { return put_f(out, t, f64_from_bits(f64_bits(x1) & 0x7FFFFFFFFFFFFFFF)); }
    if (op == "floor") { return put_f(out, t, ffloor(x1)); }
    if (op == "ceil") { return put_f(out, t, fceil(x1)); }
    if (op == "round") { return put_f(out, t, fround(x1)); }
    if (op == "trunc") { return put_f(out, t, ftrunc(x1)); }
    if (op == "fract") { return put_f(out, t, fr(t, x1 - ftrunc(x1))); }
    if (op == "recip") { return put_f(out, t, fr(t, 1.0 / x1)); }
    if (op == "signum") { return put_f(out, t, fsignum(x1)); }
    if (op == "sqrt") {
      if (t == T_F32) { return put_f(out, t, fr(t, __mtl_sqrt(x1))); }
      return put_f(out, t, __mtl_sqrt(x1));
    }
    var lr: float64 = 0.0;
    if (libm_call(op, t, x1, 0.0, false, &lr)) { return put_f(out, t, lr); }
    if (t == T_F64 && op == "to_degrees") {
      return put_f(out, t, x1 * (180.0 / 3.141592653589793));
    }
    if (t == T_F64 && op == "to_radians") {
      return put_f(out, t, x1 * (3.141592653589793 / 180.0));
    }
    return false;
  }
  if (c == 2) {
    var x2: float64 = arg_f(a, t);
    if (op == "powi") {
      var e: int64 = arg_int(a, T_I32);
      if (a->bad) { return false; }
      return put_f(out, t, powi(t, x2, (int32)e));
    }
    var y2: float64 = arg_f(a, t);
    if (a->bad) { return false; }
    var lr2: float64 = 0.0;
    if (libm_call(op, t, x2, y2, true, &lr2)) { return put_f(out, t, lr2); }
    if (op == "sub") { return put_f(out, t, fr(t, x2 - y2)); }
    if (op == "div") { return put_f(out, t, fr(t, x2 / y2)); }
    if (op == "copysign") {
      var s: int64 = f64_bits(y2) & (int64)0x8000000000000000;
      return put_f(out, t, f64_from_bits((f64_bits(x2) & 0x7FFFFFFFFFFFFFFF) | s));
    }
    if (isnan(x2) || isnan(y2)) {
      if (op == "ne") { return put_i8(out, true); }
      if (op == "lt" || op == "gt" || op == "lte" || op == "gte" || op == "eq") {
        return put_i8(out, false);
      }
    }
    if (op == "lt") { return put_i8(out, x2 < y2); }
    if (op == "gt") { return put_i8(out, x2 > y2); }
    if (op == "lte") { return put_i8(out, x2 <= y2); }
    if (op == "gte") { return put_i8(out, x2 >= y2); }
    if (op == "eq") { return put_i8(out, x2 == y2); }
    if (op == "ne") { return put_i8(out, x2 != y2); }
    return false;
  }
  if (c == 3 && op == "clamp") {
    var x3: float64 = arg_f(a, t);
    var mn: float64 = arg_f(a, t);
    var mx: float64 = arg_f(a, t);
    if (a->bad || isnan(mn) || isnan(mx) || mn > mx) { return false; }
    if (x3 < mn) { x3 = mn; }
    if (x3 > mx) { x3 = mx; }
    return put_f(out, t, x3);
  }
  return false;
}

// iN_as_T, iN_one, iN_from_string, iN_to_string and the same for floats.
fn typed_first(t: int32, op: string, a: Args*, out: MercBuf*) -> bool {
  if (!ty_float(t) && !ty_signed(t)) { return unsigned_op(t, op, a, out); }
  var c: int32 = a->count;
  if (op == "one" && !ty_float(t) && c == 0) { return put_int(out, t, 1); }
  if (op == "from_string" && c == 1) {
    var n: int64 = 0;
    var p: uint8* = arg_sym(a, &n);
    if (a->bad) { return false; }
    if (ty_float(t)) {
      var f: float64 = 0.0;
      if (!parse_float(t, p, n, &f)) { return false; }
      return put_f(out, t, f);
    }
    var v: int64 = 0;
    if (!parse_int(t, p, n, &v)) { return false; }
    return put_int(out, t, v);
  }
  if (op == "to_string" && c == 1) {
    var tmp: MercBuf;
    if (ty_float(t)) {
      var x: float64 = arg_f(a, t);
      if (a->bad) { return false; }
      merc_pure_float_text(x, t == T_F32, &tmp);
    } else {
      var v2: int64 = arg_int(a, t);
      if (a->bad) { return false; }
      put_dec(&tmp, v2);
    }
    var ok: bool = put_text(out, &tmp);
    merc_buf_free(&tmp);
    return ok;
  }
  if (op.length > 3 && op.chars[0] == 97 && op.chars[1] == 115 && op.chars[2] == 95 && c == 1) {
    var to: int32 = ty_of(pv(op.chars + 3, (int64)op.length - 3));
    if (to == 0 || to == t || (!ty_float(to) && !ty_signed(to))) { return false; }
    if (ty_float(t)) {
      var x2: float64 = arg_f(a, t);
      if (a->bad) { return false; }
      if (ty_float(to)) { return put_f(out, to, x2); }
      return put_int(out, to, f_to_int(to, x2));
    }
    var v3: int64 = arg_int(a, t);
    if (a->bad) { return false; }
    if (to == T_F64) { return put_f(out, to, i_to_f(t, v3)); }
    if (to == T_F32) { return put_f(out, to, i_to_f32(t, v3)); }
    return put_int(out, to, wrap(to, v3));
  }
  return false;
}

fn hexval(c: uint8) -> int32 {
  if (c >= 48 && c <= 57) { return (int32)c - 48; }
  if (c >= 97 && c <= 102) { return (int32)c - 87; }
  if (c >= 65 && c <= 70) { return (int32)c - 55; }
  return -1;
}

fn plain_op(name: string, a: Args*, out: MercBuf*) -> bool {
  var c: int32 = a->count;
  if (name == "ifnz") {
    if (c != 3 && c != 5) { return false; }
    var n: int64 = 0;
    var p: uint8* = arg_sym(a, &n);
    if (a->bad) { return false; }
    var nz: bool = false;
    for k: int64 in 0..n {
      if (p[k] != 0) { nz = true; }
    }
    var wn: int64 = 0;
    var w: uint8* = arg_sym(a, &wn);
    if (a->bad || pv(w, wn) != "then") { return false; }
    var then_at: int64 = arg_next(a);
    var then_end: int64 = a->at;
    if (a->bad) { return false; }
    if (nz) { return merc_buf_add(out, a->p + then_at, then_end - then_at); }
    if (c != 5) { return false; }
    var en: int64 = 0;
    var ew: uint8* = arg_sym(a, &en);
    if (a->bad || pv(ew, en) != "else") { return false; }
    var else_at: int64 = arg_next(a);
    if (a->bad) { return false; }
    return merc_buf_add(out, a->p + else_at, a->at - else_at);
  }
  if (name == "tuple") {
    merc_buf_push(out, (uint8)c);
    return merc_buf_add(out, a->p, a->n);
  }
  if (c != 1) { return false; }
  if (name == "explode_symbol") {
    var n2: int64 = 0;
    var p2: uint8* = arg_sym(a, &n2);
    if (a->bad) { return false; }
    merc_buf_push(out, (uint8)n2);
    for k2: int64 in 0..n2 {
      merc_buf_push(out, 0xC1);
      merc_buf_push(out, p2[k2]);
    }
    return true;
  }
  if (name == "collapse_symbol") {
    var tag: uint8 = a->p[0];
    if (tag >= 64) { return false; }
    var tmp: uint8[64];
    var i: int64 = 0;
    var at: int64 = 1;
    for k3 in 0..(int32)tag {
      var st: uint8 = a->p[at];
      if (st <= 0xC0) { return false; }
      var sl: int64 = (int64)(st & 63);
      if (i + sl >= 64) { return false; }
      for k4: int64 in 0..sl { tmp[i + k4] = a->p[at + 1 + k4]; }
      i = i + sl;
      at = at + 1 + sl;
    }
    if (i == 0) { return false; }
    merc_buf_push(out, (uint8)(0xC0 + i));
    return merc_buf_add(out, &tmp[0], i);
  }
  var n3: int64 = 0;
  var p3: uint8* = arg_sym(a, &n3);
  if (a->bad) { return false; }
  if (name == "reverse_symbol") {
    merc_buf_push(out, (uint8)(0xC0 + n3));
    var k5: int64 = n3 - 1;
    while (k5 >= 0) {
      merc_buf_push(out, p3[k5]);
      k5 = k5 - 1;
    }
    return true;
  }
  if (name == "encode_hex") {
    if (n3 * 2 > 63) { return false; }
    merc_buf_push(out, (uint8)(0xC0 + n3 * 2));
    var hx: string = "0123456789abcdef";
    for k6: int64 in 0..n3 {
      merc_buf_push(out, hx.chars[(int32)(p3[k6] >> 4)]);
      merc_buf_push(out, hx.chars[(int32)(p3[k6] & 15)]);
    }
    return true;
  }
  if (name == "decode_hex") {
    if (n3 % 2 != 0) { return false; }
    var start: int64 = out->len;
    merc_buf_push(out, (uint8)(0xC0 + n3 / 2));
    var k7: int64 = 0;
    while (k7 < n3) {
      var h: int32 = hexval(p3[k7]);
      var l: int32 = hexval(p3[k7 + 1]);
      if (h < 0 || l < 0) {
        out->len = start;
        return false;
      }
      merc_buf_push(out, (uint8)(h * 16 + l));
      k7 = k7 + 2;
    }
    return true;
  }
  return false;
}

fn apply(name: string, a: Args*, out: MercBuf*) -> bool {
  var n: int64 = (int64)name.length;
  var p: uint8* = name.chars;
  var cut: int64 = -1;
  for k: int64 in 0..n {
    if (cut < 0 && p[k] == 95) { cut = k; }
  }
  if (cut > 0) {
    var t: int32 = ty_of(pv(p, cut));
    if (t != 0) { return typed_first(t, pv(p + cut + 1, n - cut - 1), a, out); }
  }
  var last: int64 = -1;
  for k2: int64 in 0..n {
    if (p[k2] == 95) { last = k2; }
  }
  if (last > 0) {
    var t2: int32 = ty_of(pv(p + last + 1, n - last - 1));
    if (t2 != 0) {
      var op: string = pv(p, last);
      if (ty_float(t2)) { return float_op(t2, op, a, out); }
      if (ty_signed(t2)) { return signed_op(t2, op, a, out); }
      return false;
    }
  }
  return plain_op(name, a, out);
}

fn eval_at(p: uint8*, n: int64, out: MercBuf*, depth: int32) -> int64 {
  if (n <= 0 || depth > 200) { return -1; }
  var tag: uint8 = p[0];
  if (tag > 0xC0) {
    var len: int64 = 1 + (int64)(tag & 63);
    merc_buf_add(out, p, len);
    return len;
  }
  if (tag == 0 || tag >= 64) { return -1; }
  if (n < 2 || p[1] <= 0xC0) { return -1; }
  var hl: int64 = (int64)(p[1] & 63);
  var name: string = pv(p + 2, hl);
  var at: int64 = 2 + hl;
  if (name == "'") {
    if (tag != 2) { return -1; }
    var q: int64 = merc_span(p + at, n - at);
    if (q < 0) { return -1; }
    merc_buf_add(out, p + at, q);
    return at + q;
  }
  var args: MercBuf;
  var ok: bool = true;

  for i in 1..(int32)tag {
    var k: int64 = eval_at(p + at, n - at, &args, depth + 1);
    if (k < 0) {
      ok = false;
      break;
    }
    at = at + k;
  }

  if (ok) {
    var a: Args;
    a.p = args.data;
    a.n = args.len;
    a.count = (int32)tag - 1;
    a.at = 0;
    a.bad = false;
    var start: int64 = out->len;
    ok = apply(name, &a, out);
    if (!ok) { out->len = start; }
  }
  merc_buf_free(&args);
  if (!ok) { return -1; }
  return at;
}

export fn merc_pure_eval(call: string, out: MercBuf*) -> bool {
  var start: int64 = out->len;
  var k: int64 = eval_at(call.chars, (int64)call.length, out, 0);
  if (k != (int64)call.length) {
    out->len = start;
    return false;
  }
  return true;
}
