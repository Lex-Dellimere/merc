// a big rule step on several cores. the step is cut into parts, each part
// runs on its own, and the step puts their writes together, so the result
// is the one a single core gives. the cores are alph threads that stay
// alive between steps and sleep while there is nothing to do. the engine
// itself never needs alph, merc run and the shell's go turn this on.

import "alph/sys/atomic";
import "alph/sys/thread";
import "std/mem";
import "trie";
import "expr";
import "run";

const WIDE_MAX: int64 = 16;

var g_wide_threads: AlphThread[16];
var g_wide_handles: int64[16];
var g_wide_count: int64 = 0;
var g_wide_run: MercRun*;
var g_wide_gen: int64 = 0;
var g_wide_next: int64 = 0;
var g_wide_total: int64 = 0;
var g_wide_done: int64 = 0;
var g_wide_quit: int64 = 0;
var g_wide_busy: int64 = 0;
var g_wide_job: fn(int64) -> void;

fn futex(p: int64*, op: int64, v: int64) -> int64 {
  return syscall(202, (int64)p, op, v, 0, 0, 0);
}

fn wide_take() {
  while (true) {
    var i: int64 = alph_atomic_add(&g_wide_next, 1);
    if (i >= alph_atomic_load(&g_wide_total)) { return; }
    g_wide_job(i);
    alph_atomic_add(&g_wide_done, 1);
  }
}

fn wide_worker(id: int64) -> int64 {
  var seen: int64 = 0;
  while (true) {
    var spins: int64 = 0;
    while (alph_atomic_load(&g_wide_gen) == seen) {
      if (spins < 2000) {
        alph_cpu_relax();
        spins = spins + 1;
      } else {
        futex(&g_wide_gen, 128, seen);
      }
    }
    seen = alph_atomic_load(&g_wide_gen);
    if (alph_atomic_load(&g_wide_quit) != 0) { return 0; }
    alph_atomic_add(&g_wide_busy, 1);
    wide_take();
    alph_atomic_add(&g_wide_busy, -1);
  }
  return 0;
}

// a thread late from the last batch must not take a part of this one by an
// old number, so nothing is handed out until every thread is out and the
// counter is past any total.
fn wide_each(parts: int64, job: fn(int64) -> void) {
  alph_atomic_store_sc(&g_wide_next, 0x4000000000000000);
  while (alph_atomic_load(&g_wide_busy) != 0) { alph_cpu_relax(); }
  g_wide_job = job;
  alph_atomic_store_sc(&g_wide_done, 0);
  alph_atomic_store_sc(&g_wide_total, parts);
  alph_atomic_store_sc(&g_wide_next, 0);
  alph_atomic_add(&g_wide_gen, 1);
  futex(&g_wide_gen, 129, 1000);
  wide_take();
  while (alph_atomic_load(&g_wide_done) < parts) { alph_cpu_relax(); }
}

fn wide_run_part(i: int64) { merc_run_part(g_wide_run, i); }

fn wide_spread(r: MercRun*, parts: int64) -> bool {
  g_wide_run = r;
  wide_each(parts, &wide_run_part);
  return true;
}

// printing: the keys are cut into ranges by their first bytes, each range is
// written as text on any core into its own buffer, and the buffers go out in
// key order, the same bytes one core writes.
var g_print_trie: MercTrie*;
var g_print_pref: MercBuf;
var g_print_at: MercBuf;
var g_print_lo: MercBuf;
var g_print_out: MercBuf*;
var g_print_emit: fn(uint8*, int64) -> void;
var g_print_stream: bool = false;

fn print_range(i: int64) {
  var lo: int64 = ((int64*)g_print_lo.data)[i];
  var hi: int64 = ((int64*)g_print_lo.data)[i + 1];
  var out: MercBuf* = g_print_out + i;
  var rec: int64* = (int64*)g_print_at.data;
  var z: MercZip = merc_zip(g_print_trie);
  for x: int64 in lo..hi {
    merc_zip_reset(&z);
    var p: string;
    p.chars = g_print_pref.data + rec[2 * x];
    p.length = (uint64)rec[2 * x + 1];
    merc_zip_descend(&z, p);
    var floor: int64 = merc_zip_depth(&z);
    var more: bool = merc_zip_get(&z, (uint64*)0);
    if (!more) { more = merc_zip_next_value(&z, floor); }
    while (more) {
      merc_format(merc_zip_path(&z), out, (MercNames*)0);
      merc_buf_push(out, 10);
      if (g_print_stream && out->len > 65536) {
        g_print_emit(out->data, out->len);
        merc_buf_clear(out);
      }
      more = merc_zip_next_value(&z, floor);
    }
  }
  merc_zip_free(&z);
}

fn print_cut(t: MercTrie*) -> int64 {
  merc_buf_clear(&g_print_pref);
  merc_buf_clear(&g_print_at);
  var e: int64[2];
  e[0] = 0;
  e[1] = 0;
  merc_buf_add(&g_print_at, (uint8*)&e[0], 16);
  var n: int64 = 1;
  var bytes: MercBuf;
  var at: MercBuf;
  var z: MercZip = merc_zip(t);
  for round in 0..24 {
    if (n >= 4096) { break; }
    merc_buf_clear(&bytes);
    merc_buf_clear(&at);
    var grew: bool = false;
    var rec: int64* = (int64*)g_print_at.data;
    for i: int64 in 0..n {
      var pb: uint8* = g_print_pref.data + rec[2 * i];
      var pn: int64 = rec[2 * i + 1];
      var p: string;
      p.chars = pb;
      p.length = (uint64)pn;
      merc_zip_reset(&z);
      merc_zip_descend(&z, p);
      var c: int32 = -1;
      if (!merc_zip_get(&z, (uint64*)0)) { c = merc_zip_next(&z, 0); }
      if (c < 0) {
        e[0] = bytes.len;
        e[1] = pn;
        merc_buf_add(&bytes, pb, pn);
        merc_buf_add(&at, (uint8*)&e[0], 16);
        continue;
      }
      while (c >= 0) {
        e[0] = bytes.len;
        e[1] = pn + 1;
        merc_buf_add(&bytes, pb, pn);
        merc_buf_push(&bytes, (uint8)c);
        merc_buf_add(&at, (uint8*)&e[0], 16);
        grew = true;
        c = merc_zip_next(&z, c + 1);
      }
    }
    n = at.len / 16;
    merc_buf_clear(&g_print_pref);
    merc_buf_add(&g_print_pref, bytes.data, bytes.len);
    merc_buf_clear(&g_print_at);
    merc_buf_add(&g_print_at, at.data, at.len);
    if (!grew) { break; }
  }
  merc_zip_free(&z);
  merc_buf_free(&bytes);
  merc_buf_free(&at);
  return n;
}

export fn merc_wide_print(t: MercTrie*, emit: fn(uint8*, int64) -> void) {
  if (merc_count(t) == 0) { return; }
  var n: int64 = 1;
  var ranges: int64 = 1;
  g_print_stream = true;
  if (g_wide_count > 0 && merc_count(t) > 20000) {
    n = print_cut(t);
    ranges = n;
    if (ranges > 512) { ranges = 512; }
    g_print_stream = false;
  } else {
    merc_buf_clear(&g_print_pref);
    merc_buf_clear(&g_print_at);
    var e: int64[2];
    e[0] = 0;
    e[1] = 0;
    merc_buf_add(&g_print_at, (uint8*)&e[0], 16);
  }
  g_print_emit = emit;
  merc_buf_clear(&g_print_lo);
  for i: int64 in 0..(ranges + 1) {
    var lo: int64 = n * i / ranges;
    merc_buf_add(&g_print_lo, (uint8*)&lo, 8);
  }
  g_print_trie = t;
  g_print_out = (MercBuf*)calloc(ranges, sizeof(MercBuf));
  if (ranges > 1) { wide_each(ranges, &print_range); } else { print_range(0); }
  for i2: int64 in 0..ranges {
    if (g_print_out[i2].len > 0) { emit(g_print_out[i2].data, g_print_out[i2].len); }
    merc_buf_free(g_print_out + i2);
  }
  free(g_print_out);
}

// starts cores less one threads, the calling thread being the last core,
// and lets r spread its big steps over them.
export fn merc_wide_start(r: MercRun*, cores: int64) {
  if (cores < 2) { return; }
  if (g_wide_count == 0) {
    var n: int64 = cores - 1;
    if (n > WIDE_MAX) { n = WIDE_MAX; }
    alph_atomic_store_sc(&g_wide_quit, 0);
    for i: int64 in 0..n {
      g_wide_handles[i] = alph_thread_start(&g_wide_threads[i], &wide_worker, i, 1048576);
      if (g_wide_handles[i] != 0) { g_wide_count = g_wide_count + 1; }
    }
  }
  if (g_wide_count > 0) { r->spread = &wide_spread; }
}

export fn merc_wide_stop() {
  if (g_wide_count == 0) { return; }
  alph_atomic_store_sc(&g_wide_quit, 1);
  alph_atomic_add(&g_wide_gen, 1);
  futex(&g_wide_gen, 129, 1000);
  for i: int64 in 0..g_wide_count {
    if (g_wide_handles[i] != 0) { alph_thread_join(g_wide_handles[i], &g_wide_threads[i]); }
  }
  g_wide_count = 0;
}
