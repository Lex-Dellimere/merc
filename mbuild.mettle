// project file for merc. it builds one program, merc.

import "mbuild/api";

fn project() {
  mb_package("merc", "0.1.0");
  mb_meta("description", "a store for symbolic expressions. load them, search them with patterns, run rules over them");
  mb_meta("repository", "https://github.com/Lex-Dellimere/merc");
  mb_import_root("src");
  mb_targets("linux");
  mb_bin("merc", "src/main.mettle");
  mb_link_libs("c");

  // alph needs its port for this machine, which comes inside the package.
  mb_for_bin("merc");
  mb_set_list("flags", "-I, .mbuild/deps/alph/ports/host");
}

fn deps() {
  mb_dep("alph", "0.2.0");
  mb_dep("mythic", "0.1.0");
}
